#!/usr/bin/env bash
# Only operator prerequisites: fresh application project, network and private bootstrap inputs.
set -euo pipefail
[[ ${TEND_DISPOSABLE_RUNNER:-} == yes ]]
umask 077
fixture=$(mktemp -d /tmp/tend-ci-rebuild.XXXXXX)
printf '%s\n' "$fixture" >out/incus-smoke/rebuild-directory.txt
sudo incus project create tend-ci-rebuild -c features.images=false -c features.networks=false -c features.profiles=true -c features.storage.volumes=true
sudo incus network create tend-ci-full --type=bridge ipv4.address=10.81.0.1/24 ipv4.nat=true ipv6.address=none \
    'raw.dnsmasq=address=/.compose.localhost/10.81.0.10'
if sudo iptables -nL DOCKER-USER >/dev/null 2>&1; then
    sudo iptables -I DOCKER-USER -i tend-ci-full -j ACCEPT
    sudo iptables -I DOCKER-USER -o tend-ci-full -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
fi
previous=$(cat out/incus-smoke/controller-directory.txt)
cp "$previous/java.args" "$previous/trust.p12" "$previous/store-password" "$fixture/"
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=tend-ci-rebuild -addext extendedKeyUsage=clientAuth \
    -keyout "$fixture/client.key" -out "$fixture/client.crt" >"$fixture/openssl.private" 2>&1
openssl x509 -in "$fixture/client.crt" -outform der | sha256sum | cut -d' ' -f1 >"$fixture/client-fingerprint"
openssl pkcs12 -export -name tend-ci-rebuild -inkey "$fixture/client.key" -in "$fixture/client.crt" \
    -out "$fixture/client.p12" -passout "file:$fixture/store-password"
printf '%s\n' watch /srv/tend-git/remote.git https://10.81.0.1:8443 tend-ci-rebuild tend-ci-rebuild /var/lib/tend 1 >"$fixture/controller.args"
sudo incus config trust add-certificate "$fixture/client.crt" --name tend-ci-rebuild --restricted --projects tend-ci-rebuild
users=$(cat out/incus-smoke/authelia-fixture-directory.txt)
mkdir "$fixture/users"
cp "$users/inputs/users.yml" "$fixture/users/users.yml"
python3 - "$fixture/users/users.yml" <<'PYTHON'
import json,pathlib,sys
p=pathlib.Path(sys.argv[1]);s=json.loads(p.read_text());s['users']['carol']['groups']=['admins','ai-users'];p.write_text(json.dumps(s))
PYTHON
sudo python3 scripts/bootstrap/private-volume create users local tend-ci-rebuild tend-ci-pool private-users tend-ci-rebuild 1000 "$fixture/users"
metrics=$(cat out/incus-smoke/metrics-directory.txt)
mkdir "$fixture/metrics"
cp "$metrics/valid/"* "$fixture/metrics/"
cp "$fixture/client.crt" "$fixture/metrics/controller.crt"
sudo python3 scripts/bootstrap/private-volume create metrics local tend-ci-rebuild tend-ci-pool incus-metrics tend-ci-rebuild 65534 "$fixture/metrics"
chmod 0600 "$fixture"/client.p12 "$fixture"/trust.p12 "$fixture"/java.args "$fixture"/controller.args
