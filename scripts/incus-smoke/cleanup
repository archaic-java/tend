#!/usr/bin/env bash
# Safe only within the explicitly disposable test environment.
set -u
[[ ${TEND_DISPOSABLE_RUNNER:-} == yes ]] || exit 1
# Stop the OCI writer first so it cannot recreate application resources during teardown.
timeout 30 sudo incus delete tend-ci-watch --project tend-ci-oci --force || true
timeout 30 sudo incus delete tend-ci-oci-app --project tend-ci-oci --force || true
timeout 30 sudo incus storage volume list tend-ci-pool --project tend-ci-oci --format=json 2>/dev/null | python3 -c '
import json,sys
for volume in json.load(sys.stdin):
    config=volume.get("config", {})
    if volume.get("type") == "custom" and (config.get("user.tend.bootstrap") == "tend-ci-oci" or config.get("user.tend.owner") == "tend-ci-oci"):
        print(volume["name"])
' | while IFS= read -r volume; do
    timeout 30 sudo incus storage volume delete tend-ci-pool "$volume" --project tend-ci-oci || true
done
timeout 30 sudo incus project delete tend-ci-oci || true
timeout 30 sudo incus image delete tend-ci-controller-oci || true
if [[ -f out/incus-smoke/controller-directory.txt ]]; then
    controller=$(cat out/incus-smoke/controller-directory.txt)
    if [[ $controller == /tmp/tend-ci-controller.* ]]; then
        timeout 30 sudo incus config trust remove "$(cat "$controller/client-fingerprint")" || true
        sudo rm -rf -- "$controller"
    fi
fi
for name in tend-ci-client tend-ci-server tend-ci-managed tend-ci-policy-client tend-ci-policy-server tend-ci-gateway tend-ci-ingress-backend tend-ci-ingress-authorization tend-ci-ingress-client tend-ci-ingress-seed tend-ci-auth-gateway tend-ci-auth-service tend-ci-auth-backend tend-ci-auth-client tend-ci-authelia-seed tend-ci-grafana tend-ci-pi tend-ci-private-operator tend-ci-native-gateway tend-ci-native-auth tend-ci-native-backend tend-ci-native-client tend-ci-prometheus tend-ci-monitor-grafana; do
    timeout 30 sudo incus delete "$name" --force || true
done
timeout 30 sudo incus network acl delete tend-ci-egress || true
# These generated ACLs belong only to disposable Tend fixtures, including partial deployments.
timeout 30 sudo incus network acl list --format=json 2>/dev/null | python3 -c '
import json,sys
for acl in json.load(sys.stdin):
    if acl.get("config", {}).get("user.tend.owner") == "tend-ci-controller":
        print(acl["name"])
' | while IFS= read -r acl; do
    timeout 30 sudo incus network acl delete "$acl" || true
done
if sudo iptables -nL DOCKER-USER >/dev/null 2>&1; then
    sudo iptables -D DOCKER-USER -i tend-ci-pi-net -j ACCEPT || true
    sudo iptables -D DOCKER-USER -o tend-ci-pi-net -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT || true
fi
timeout 30 sudo incus network delete tend-ci-ctl || true
timeout 30 sudo incus network delete tend-ci-nlan || true
timeout 30 sudo incus network delete tend-ci-pi-net || true
timeout 30 sudo incus network delete tend-ci-ovn || true
timeout 30 sudo incus network delete tend-ci-uplink || true
timeout 30 sudo incus storage volume delete tend-ci-pool tend-ci-private-users || true
timeout 30 sudo incus storage volume delete tend-ci-pool tend-ci-native-users || true
timeout 30 sudo incus storage volume delete tend-ci-pool tend-ci-metrics-tls || true
timeout 30 sudo incus storage volume delete tend-ci-pool tend-ci-data || true
timeout 30 sudo incus storage volume delete tend-ci-pool tend-ci-grafana-data || true
# Generated configuration volumes are retained by Tend; remove only this fixture owner's volumes.
timeout 30 sudo incus storage volume list tend-ci-pool --format=json 2>/dev/null | python3 -c '
import json,sys
for volume in json.load(sys.stdin):
    if volume.get("type") == "custom" and volume.get("config", {}).get("user.tend.owner") == "tend-ci-controller":
        print(volume["name"])
' | while IFS= read -r volume; do
    timeout 30 sudo incus storage volume delete tend-ci-pool "$volume" || true
done
for image in tend-ci-prometheus tend-ci-native-caddy tend-ci-native-authelia tend-ci-caddy tend-ci-probe tend-ci-authelia tend-ci-grafana tend-ci-pi tend-ci-private-operator tend-ci-native-gateway tend-ci-native-auth tend-ci-native-backend tend-ci-native-client tend-ci-prometheus tend-ci-monitor-grafana; do
    timeout 30 sudo incus image delete "$image" || true
done
sudo incus remote remove tend-ci-docker || true
if [[ -f out/incus-smoke/client-fingerprint.txt ]]; then
    timeout 30 sudo incus config trust remove "$(cat out/incus-smoke/client-fingerprint.txt)" || true
fi
if [[ -f out/incus-smoke/credentials-directory.txt ]]; then
    credentials=$(cat out/incus-smoke/credentials-directory.txt)
    [[ $credentials == /tmp/tend-ci-tls.* ]] && rm -rf -- "$credentials"
fi
if [[ -f out/incus-smoke/authelia-fixture-directory.txt ]]; then
    fixture=$(cat out/incus-smoke/authelia-fixture-directory.txt)
    [[ $fixture == /tmp/tend-ci-authelia.* ]] && rm -rf -- "$fixture"
fi
timeout 30 sudo incus storage delete tend-ci-pool || true

if [[ -f out/incus-smoke/metrics-fingerprint.txt ]]; then
    timeout 30 sudo incus config trust remove "$(cat out/incus-smoke/metrics-fingerprint.txt)" || true
fi
if [[ -f out/incus-smoke/metrics-directory.txt ]]; then
    metrics=$(cat out/incus-smoke/metrics-directory.txt)
    [[ $metrics == /tmp/tend-ci-metrics.* ]] && rm -rf -- "$metrics"
fi
