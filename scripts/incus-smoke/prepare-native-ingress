#!/usr/bin/env bash
# Upstream OCI images, cached once; no private users are placed in image layers.
set -euo pipefail
[[ ${TEND_DISPOSABLE_RUNNER:-} == yes ]]
for declaration in \
    'caddy library/caddy@sha256:13b7fbadd017b042956fddbceedeeea12bb1e560534f9b3df281269dbcc61813' \
    'authelia authelia/authelia@sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54'; do
    read -r name image <<<"$declaration"
    printf '%s\n' "$image" >"out/incus-smoke/native-$name-oci-image.txt"
    timeout 180 sudo incus image copy "tend-ci-docker:$image" local: --alias "tend-ci-native-$name"
    sudo incus image info "tend-ci-native-$name" >"out/incus-smoke/native-$name-image.txt"
    sed -n 's/^Fingerprint: //p' "out/incus-smoke/native-$name-image.txt" >"out/incus-smoke/native-$name-fingerprint.txt"
done
sudo incus network create tend-ci-nlan --type=bridge ipv4.address=10.80.0.1/24 ipv4.nat=false ipv6.address=none
fixture=$(cat out/incus-smoke/authelia-fixture-directory.txt)
sudo python3 scripts/bootstrap/private-volume create users local default tend-ci-pool \
    tend-ci-native-users tend-ci-controller 1000 "$fixture/inputs"
