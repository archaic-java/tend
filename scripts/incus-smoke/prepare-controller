#!/usr/bin/env bash
# Build/import only on the disposable runner; private credentials stay outside artifacts.
set -euo pipefail
[[ ${TEND_DISPOSABLE_RUNNER:-} == yes ]]
umask 077
fixture=$(mktemp -d /tmp/tend-ci-controller.XXXXXX)
printf '%s\n' "$fixture" >out/incus-smoke/controller-directory.txt
sudo apt-get install -y --no-install-recommends skopeo umoci
sudo bash scripts/bootstrap/export-controller "$fixture/artifact"
sudo incus image import "$fixture/artifact/metadata.tar.gz" "$fixture/artifact/rootfs.tar.gz" \
    --alias tend-ci-controller-oci
sudo incus image info tend-ci-controller-oci >out/incus-smoke/controller-image.txt
sed -n 's/^Fingerprint: //p' out/incus-smoke/controller-image.txt >out/incus-smoke/controller-fingerprint.txt
sudo cp "$fixture/artifact/provenance.json" out/incus-smoke/controller-provenance.json
# A dedicated project tests restricted controller trust and avoids all other fixture resources.
sudo incus project create tend-ci-oci -c features.images=false -c features.networks=false \
    -c features.profiles=true -c features.storage.volumes=true
sudo incus network create tend-ci-ctl --type=bridge \
    ipv4.address=10.79.0.1/24 ipv4.nat=true ipv6.address=none
openssl req -x509 -newkey rsa:2048 -nodes -days 1 \
    -subj /CN=tend-ci-oci -addext extendedKeyUsage=clientAuth \
    -keyout "$fixture/client.key" -out "$fixture/client.crt"
openssl x509 -in "$fixture/client.crt" -outform der | sha256sum | cut -d' ' -f1 >"$fixture/client-fingerprint"
python3 - "$fixture" <<'PY'
import pathlib, secrets, sys
p=pathlib.Path(sys.argv[1])
password=secrets.token_hex(24)
(p/'store-password').write_text(password+'\n')
(p/'java.args').write_text('\n'.join([
    '-Djavax.net.ssl.keyStore=/etc/tend-bootstrap/client.p12',
    '-Djavax.net.ssl.keyStoreType=PKCS12',
    '-Djavax.net.ssl.keyStorePassword='+password,
    '-Djavax.net.ssl.trustStore=/etc/tend-bootstrap/trust.p12',
    '-Djavax.net.ssl.trustStoreType=PKCS12',
    '-Djavax.net.ssl.trustStorePassword='+password])+'\n')
(p/'controller.args').write_text('watch\n/srv/tend-git/remote.git\nhttps://10.79.0.1:8443\ntend-ci-oci\ntend-ci-oci\n/var/lib/tend\n1\n')
PY
openssl pkcs12 -export -name tend-ci-oci -inkey "$fixture/client.key" -in "$fixture/client.crt" \
    -out "$fixture/client.p12" -passout "file:$fixture/store-password"
credentials=$(cat out/incus-smoke/credentials-directory.txt)
keytool -importcert -noprompt -alias incus -file "$credentials/server.crt" \
    -keystore "$fixture/trust.p12" -storetype PKCS12 -storepass:file "$fixture/store-password"
# A valid but unrelated trust anchor tests handshake rejection instead of corrupt-store startup.
keytool -importcert -noprompt -alias wrong -file "$fixture/client.crt" \
    -keystore "$fixture/wrong-trust.p12" -storetype PKCS12 -storepass:file "$fixture/store-password"
sudo incus config trust add-certificate "$fixture/client.crt" --name tend-ci-oci --restricted --projects tend-ci-oci
chmod 0600 "$fixture"/client.p12 "$fixture"/trust.p12 "$fixture"/java.args "$fixture"/controller.args
