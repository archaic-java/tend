#!/usr/bin/env bash
# Best effort: retain evidence even when package installation or provisioning failed.
set -u
mkdir -p out/incus-smoke
capture() {
    name=$1; shift
    timeout 30 "$@" >"out/incus-smoke/$name.txt" 2>&1 || true
}
capture services sudo systemctl status incus openvswitch-switch ovn-central ovn-host --no-pager
capture journal sudo journalctl -u incus -u ovn-central -u ovn-host -u openvswitch-switch --no-pager -n 500
capture addresses ip -details address
capture routes ip route
capture ovs sudo ovs-vsctl show
capture ovn-northbound sudo ovn-nbctl show
capture ovn-acls sudo ovn-nbctl list ACL
capture ovn-port-groups sudo ovn-nbctl list Port_Group
capture ovn-southbound sudo ovn-sbctl show
capture networks sudo incus network list
capture uplink sudo incus network show tend-ci-uplink
capture ovn sudo incus network show tend-ci-ovn
capture instances sudo incus list
capture client sudo incus config show tend-ci-client --expanded
capture server sudo incus config show tend-ci-server --expanded
for name in client server policy-client policy-server; do
    capture "$name-addresses" sudo incus exec "tend-ci-$name" -- /root/busybox ip address
    capture "$name-routes" sudo incus exec "tend-ci-$name" -- /root/busybox ip route
done
capture policy-client sudo incus config show tend-ci-policy-client --expanded
capture policy-server sudo incus config show tend-ci-policy-server --expanded
if [[ -f out/incus-smoke/egress-acl.txt ]]; then
    capture policy-acl sudo incus network acl show "$(cat out/incus-smoke/egress-acl.txt)"
fi
capture managed sudo incus config show tend-ci-managed --expanded
capture managed-state sudo incus info tend-ci-managed
capture managed-volume sudo incus storage volume show tend-ci-pool tend-ci-data
for name in gateway ingress-backend ingress-authorization ingress-client; do
    capture "$name" sudo incus config show "tend-ci-$name" --expanded
    capture "$name-console" sudo incus console "tend-ci-$name" --show-log
    capture "$name-addresses" sudo incus exec "tend-ci-$name" -- /bin/busybox ip address
    capture "$name-routes" sudo incus exec "tend-ci-$name" -- /bin/busybox ip route
done
capture caddy-log sudo incus exec tend-ci-gateway -- cat /var/log/tend-caddy.log
capture caddyfile sudo incus exec tend-ci-gateway -- cat /etc/caddy/Caddyfile
capture caddy-service sudo incus exec tend-ci-gateway -- rc-service tend-caddy status
capture volumes sudo incus storage volume list tend-ci-pool
capture operations sudo incus operation list
capture acl sudo incus network acl show tend-ci-egress
capture client-console sudo incus console tend-ci-client --show-log
capture server-console sudo incus console tend-ci-server --show-log
capture nft sudo nft list ruleset
capture iptables sudo iptables-save
