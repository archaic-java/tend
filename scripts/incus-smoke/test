#!/usr/bin/env bash
set -euo pipefail
[[ ${TEND_DISPOSABLE_RUNNER:-} == yes ]]
from=${TEND_SMOKE_FROM:-OvnSmokeTests}
case "$from" in
    OvnSmokeTests|ControllerSmokeTests) ;;
    *) echo 'Unsupported smoke continuation point.' >&2; exit 1 ;;
esac
selected=false
# Bound memory: component suites reuse their existing checks; composition gets its own project.
for suite in OvnSmokeTests ReconciliationSmokeTests EgressSmokeTests IngressSmokeTests ControllerSmokeTests PiSmokeTests AuthorizationSmokeTests NativeIngressSmokeTests; do
    [[ $suite != "$from" ]] || selected=true
    [[ $selected == true ]] || continue
    echo "Running $suite (continuation: $from)"
    java @cmd/incus-smoke --suite "work.archaic.tend.integration.$suite"
done
sudo incus list --format=json | python3 -c '
import json,sys
for instance in json.load(sys.stdin):
    if instance.get("config",{}).get("user.tend.owner") == "tend-ci-controller" and instance.get("status") == "Running":
        print(instance["name"])
' | while IFS= read -r name; do timeout 60 sudo incus stop "$name" --timeout=30; done
java @cmd/incus-smoke --suite work.archaic.tend.integration.RebuildSmokeTests
