#!/bin/sh
# Fetch explicit, pinned inputs. After preparation, compilation and tests are offline.
set -eu
cd "$(dirname "$0")/.."
prepare_source() {
    repository=$1
    revision=$2
    directory="../$repository"
    if [ ! -d "$directory/.git" ]; then
        git clone "https://github.com/archaic-java/$repository.git" "$directory"
        git -C "$directory" checkout --detach "$revision"
    fi
    actual=$(git -C "$directory" rev-parse HEAD)
    if [ "$actual" != "$revision" ]; then
        printf '%s\n' "$directory must be at $revision (found $actual)" >&2
        exit 1
    fi
}
prepare_source service-catalog 69f61743dc0b8a67f18b06231e3139ce0054eaf2
prepare_source minau 93bb952390b412fbaa38b2805bcf954fb6b5bd82
prepare_source culpa e3db79e01fb4891d22877102b2824b4943ebec0b
mkdir -p lib/bin
jar=lib/bin/gson-2.14.0.jar
if [ ! -f "$jar" ]; then
    temporary=$(mktemp lib/bin/gson.XXXXXX)
    trap 'rm -f "$temporary"' EXIT HUP INT TERM
    curl --retry 3 --retry-max-time 60 -fsSL https://repo.maven.apache.org/maven2/com/google/code/gson/gson/2.14.0/gson-2.14.0.jar -o "$temporary"
    printf '%s  %s\n' 2cbd119bf1961c28788310963dc80ba65f58cdeec1dd139c8bdb1240faa2c36f "$temporary" | sha256sum -c -
    mv "$temporary" "$jar"
    trap - EXIT HUP INT TERM
fi
printf '%s  %s\n' 2cbd119bf1961c28788310963dc80ba65f58cdeec1dd139c8bdb1240faa2c36f "$jar" | sha256sum -c -
chmod 0644 "$jar"
jar --describe-module --file "$jar" --release 9

# Public deployment recipe is an integration/offline fixture, pinned independently of modules.
garden_revision=f623686683d0ddf8b9ff1306bd12b651bf38adda
if [ ! -d ../digital-garden/.git ]; then
    git clone https://github.com/mitschwimmer/digital-garden.git ../digital-garden
    git -C ../digital-garden checkout --detach "$garden_revision"
fi
actual=$(git -C ../digital-garden rev-parse HEAD)
if [ "$actual" != "$garden_revision" ]; then
    printf '%s\n' "../digital-garden must be at $garden_revision (found $actual)" >&2
    exit 1
fi
