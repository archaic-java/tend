<?xml version="1.0" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="name">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="mode">
    <xs:restriction base="xs:string">
      <xs:pattern value="0[0-7]{3}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="filePath"><xs:restriction base="xs:string">
    <xs:pattern value="/[a-zA-Z0-9][a-zA-Z0-9_.-]*"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="directoryPath"><xs:restriction base="xs:string">
    <xs:pattern value="(/[a-zA-Z0-9][a-zA-Z0-9_.-]*)+"/>
  </xs:restriction></xs:simpleType>
  <xs:simpleType name="port"><xs:restriction base="xs:int">
    <xs:minInclusive value="1"/><xs:maxInclusive value="65535"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="config">
    <xs:sequence>
      <xs:element name="entry" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="key" type="xs:string" use="required"/>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="incus">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="secret" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:attribute name="name" type="name" use="required"/>
            <xs:attribute name="kind" default="random"><xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="random"/><xs:enumeration value="rsa-3072"/><xs:enumeration value="pbkdf2-sha512"/>
            </xs:restriction></xs:simpleType></xs:attribute>
            <xs:attribute name="source" type="name"/>
            <xs:attribute name="bytes" default="32">
              <xs:simpleType>
                <xs:restriction base="xs:integer">
                  <xs:minInclusive value="32"/>
                  <xs:maxInclusive value="128"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="configuration" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:sequence>
            <xs:element name="file" minOccurs="1" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="path" type="filePath" use="required"/>
                <xs:attribute name="source" type="xs:string" use="required"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence><xs:attribute name="name" type="name" use="required"/></xs:complexType>
        </xs:element>
        <xs:element name="volume" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="config" type="config" minOccurs="0"/>
              <xs:element name="file" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="path" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:pattern value="/[a-zA-Z0-9][a-zA-Z0-9_.-]*"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                  <xs:attribute name="source" type="xs:string"/>
                  <xs:attribute name="secret" type="name"/>
                  <xs:attribute name="uid" type="xs:nonNegativeInteger" default="0"/>
                  <xs:attribute name="gid" type="xs:nonNegativeInteger" default="0"/>
                  <xs:attribute name="mode" type="mode" default="0644"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="name" use="required"/>
            <xs:attribute name="pool" type="name" use="required"/>
            <xs:attribute name="private-owner" type="name"/>
            <xs:attribute name="private-uid" type="xs:nonNegativeInteger"/>
            <xs:attribute name="private-kind"><xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="users"/><xs:enumeration value="metrics"/><xs:enumeration value="smtp"/>
            </xs:restriction></xs:simpleType></xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="instance" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="config" type="config" minOccurs="0"/>
              <xs:element name="device" minOccurs="1" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="config" type="config"/>
                  </xs:sequence>
                  <xs:attribute name="name" type="name" use="required"/>
                  <xs:attribute name="type" use="required">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:enumeration value="disk"/>
                        <xs:enumeration value="nic"/>
                        <xs:enumeration value="gpu"/>
                        <xs:enumeration value="unix-char"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:attribute>
                </xs:complexType>
              </xs:element>
              <xs:element name="mount" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:attribute name="name" type="name" use="required"/>
                  <xs:attribute name="configuration" type="name"/>
                  <xs:attribute name="secret" type="name"/>
                  <xs:attribute name="pool" type="name" use="required"/>
                  <xs:attribute name="path" type="directoryPath" use="required"/>
                  <xs:attribute name="uid" type="xs:int" default="0"/>
                  <xs:attribute name="gid" type="xs:int" default="0"/>
                  <xs:attribute name="mode" type="mode" default="0400"/>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:attribute name="name" type="name" use="required"/>
            <xs:attribute name="type" default="container">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="container"/>
                  <xs:enumeration value="virtual-machine"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="fingerprint" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:pattern value="[a-f0-9]{64}"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="state" default="running">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="running"/>
                  <xs:enumeration value="stopped"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
          </xs:complexType>
        </xs:element>
        <xs:element name="ingress-gateway" minOccurs="0">
          <xs:complexType>
            <xs:sequence><xs:element name="metrics" minOccurs="0"><xs:complexType>
              <xs:attribute name="device" type="name" use="required"/>
            </xs:complexType></xs:element></xs:sequence>
            <xs:attribute name="instance" type="name" use="required"/>
            <xs:attribute name="pool" type="name" use="required"/>
            <xs:attribute name="path" type="directoryPath" use="required"/>
            <xs:attribute name="authorization-instance" type="name" use="required"/>
            <xs:attribute name="authorization-device" type="name" use="required"/>
            <xs:attribute name="authorization-port" type="port" default="9091"/>
            <xs:attribute name="authorization-path" type="directoryPath" use="required"/>
            <xs:attribute name="uid" type="xs:int" default="0"/>
            <xs:attribute name="gid" type="xs:int" default="0"/>
            <xs:attribute name="authorization-uid" type="xs:int" default="0"/>
            <xs:attribute name="authorization-gid" type="xs:int" default="0"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="ingress" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:choice>
            <xs:element name="public"><xs:complexType/></xs:element>
            <xs:element name="authorization"><xs:complexType><xs:sequence>
              <xs:element name="group" minOccurs="1" maxOccurs="unbounded"><xs:complexType>
                <xs:attribute name="name" type="name" use="required"/>
              </xs:complexType></xs:element>
            </xs:sequence><xs:attribute name="policy" default="two_factor"><xs:simpleType><xs:restriction base="xs:string">
              <xs:enumeration value="one_factor"/><xs:enumeration value="two_factor"/>
            </xs:restriction></xs:simpleType></xs:attribute></xs:complexType></xs:element>
          </xs:choice>
            <xs:attribute name="name" type="name" use="required"/>
            <xs:attribute name="host" type="xs:string" use="required"/>
            <xs:attribute name="instance" type="name" use="required"/>
            <xs:attribute name="device" type="name" use="required"/>
            <xs:attribute name="port" type="port" use="required"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="egress" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType><xs:sequence>
            <xs:element name="allow" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
              <xs:attribute name="address" type="xs:string" use="required"/>
              <xs:attribute name="protocol" use="required"><xs:simpleType><xs:restriction base="xs:string">
                <xs:enumeration value="tcp"/><xs:enumeration value="udp"/>
              </xs:restriction></xs:simpleType></xs:attribute>
              <xs:attribute name="port" type="port" use="required"/>
            </xs:complexType></xs:element>
          </xs:sequence>
            <xs:attribute name="name" type="name" use="required"/>
            <xs:attribute name="instance" type="name" use="required"/>
            <xs:attribute name="device" type="name" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="project" type="name" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
