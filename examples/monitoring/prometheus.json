{
  "global": {
    "scrape_interval": "30s",
    "scrape_timeout": "10s"
  },
  "scrape_configs": [
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "10.20.0.14:9090"
          ]
        }
      ]
    },
    {
      "job_name": "caddy",
      "static_configs": [
        {
          "targets": [
            "10.20.0.10:9180"
          ]
        }
      ]
    },
    {
      "job_name": "authelia",
      "static_configs": [
        {
          "targets": [
            "10.20.0.11:9959"
          ]
        }
      ]
    },
    {
      "job_name": "grafana",
      "static_configs": [
        {
          "targets": [
            "10.20.0.13:3000"
          ]
        }
      ]
    },
    {
      "job_name": "incus",
      "scheme": "https",
      "metrics_path": "/1.0/metrics",
      "static_configs": [
        {
          "targets": [
            "incus.garden.internal:8443"
          ]
        }
      ],
      "tls_config": {
        "ca_file": "/etc/incus-tls/server.crt",
        "cert_file": "/etc/incus-tls/client.crt",
        "key_file": "/etc/incus-tls/client.key",
        "server_name": "incus.garden.internal"
      }
    },
    {
      "job_name": "llama",
      "metrics_path": "/metrics",
      "params": {
        "autoload": [
          "false"
        ]
      },
      "static_configs": [
        {
          "targets": [
            "10.20.0.16:8080"
          ],
          "labels": {
            "model": "garden-model"
          }
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "model"
          ],
          "target_label": "__param_model"
        }
      ]
    }
  ]
}
