    <device name="root" type="disk"><config><entry key="pool" value="pool"/><entry key="path" value="/"/></config></device>
    <device name="eth0" type="nic"><config><entry key="network" value="garden-private"/><entry key="ipv4.address" value="10.20.0.13"/></config></device>
    <device name="data" type="disk"><config><entry key="pool" value="pool"/><entry key="source" value="grafana-data"/><entry key="path" value="/var/lib/grafana"/></config></device>
