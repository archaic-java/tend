    <mount name="provider" configuration="dashboard-provider" pool="pool" path="/etc/grafana/provisioning/dashboards" uid="472" gid="0" mode="0644"/>
    <mount name="dashboard" configuration="incus-dashboard" pool="pool" path="/etc/tend-dashboards" uid="472" gid="0" mode="0644"/>
    <mount name="admin" secret="grafana-admin" pool="pool" path="/etc/tend-grafana-admin" uid="472" gid="0"/>
    <mount name="encryption" secret="grafana-encryption" pool="pool" path="/etc/tend-grafana-encryption" uid="472" gid="0"/>
  </instance>
</incus>
