    <entry key="security.shifted" value="true"/><entry key="initial.uid" value="65534"/><entry key="initial.gid" value="65534"/><entry key="initial.mode" value="0700"/>
  </config></volume>
  <volume pool="pool" name="grafana-data"><config>
    <entry key="security.shifted" value="true"/><entry key="initial.uid" value="472"/><entry key="initial.gid" value="0"/><entry key="initial.mode" value="0700"/>
  </config></volume>
  <instance name="prometheus" fingerprint="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">
    <config><entry key="oci.uid" value="65534"/><entry key="oci.gid" value="65534"/></config>
    <device name="root" type="disk"><config><entry key="pool" value="pool"/><entry key="path" value="/"/></config></device>
    <device name="eth0" type="nic"><config><entry key="network" value="garden-private"/><entry key="ipv4.address" value="10.20.0.14"/></config></device>
    <device name="data" type="disk"><config><entry key="pool" value="pool"/><entry key="source" value="prometheus-data"/><entry key="path" value="/prometheus"/></config></device>
    <device name="metrics" type="disk"><config><entry key="pool" value="pool"/><entry key="source" value="incus-metrics"/><entry key="path" value="/etc/incus-tls"/><entry key="readonly" value="true"/></config></device>
    <mount name="settings" configuration="prometheus" pool="pool" path="/etc/prometheus" uid="65534" gid="65534" mode="0644"/>
  </instance>
  <instance name="grafana" fingerprint="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb">
    <config><entry key="oci.uid" value="472"/><entry key="oci.gid" value="0"/>
      <entry key="environment.GF_SECURITY_ADMIN_PASSWORD__FILE" value="/etc/tend-grafana-admin/value"/>
      <entry key="environment.GF_SECURITY_SECRET_KEY__FILE" value="/etc/tend-grafana-encryption/value"/>
      <entry key="environment.GF_METRICS_ENABLED" value="true"/>
